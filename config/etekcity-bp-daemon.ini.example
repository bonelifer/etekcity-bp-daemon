[monitor]
# Leave address empty to auto-discover the device on first run (power it on
# with the MEM button while the daemon is scanning). Once discovered, this
# file is updated automatically so future restarts reconnect directly
# instead of scanning again.
address =

# Optional BLE adapter to use, e.g. hci0 (Linux only). Leave empty for the
# system default adapter.
adapter =

# Seconds to ignore advertisements after a disconnection, so a device still
# finishing its own disconnect handshake doesn't trigger a reconnect storm.
cooldown_seconds = 5

[storage]
# Path to the SQLite database file where readings are recorded.
db_path = /var/lib/etekcity-bp-daemon/readings.db

[daemon]
# Logging level: DEBUG, INFO, WARNING, ERROR
log_level = INFO

[report]
# Include the device's BLE address as a column/field.
include_address = yes

# Show which profile (or "User N" if unset) each reading belongs to.
include_profile = no

# Print an avg/min/max summary and AHA category breakdown below the title.
include_summary = yes

# Shade each table row by AHA blood-pressure category (normal/elevated/
# stage 1/stage 2/hypertensive crisis) and include a Category column.
include_categories = yes

# Unit to render pressure values in: mmhg or kpa. Stored readings always
# include both; this only affects report display.
unit = mmhg

# Date/time format: us (MM/DD/YYYY, 12-hour) or world (DD/MM/YYYY, 24-hour)
date_format = world

# PDF page size: letter or a4
page_size = letter

[mqtt]
# Publish each reading to an MQTT broker as JSON. Defaults to no. A broker
# outage is logged and non-fatal -- it never blocks local recording.
enabled = no
# Required if enabled = yes.
host =
port = 1883
# Optional broker credentials; leave blank if not required.
username =
password =
# yes or no -- wraps the connection in TLS
use_tls = no
# Messages publish to <topic_prefix>/<device address>/state
topic_prefix = etekcity_bp_daemon
# 0, 1, or 2
qos = 0
# yes or no -- whether the broker retains the last message for new subscribers
retain = yes

[alerting]
# Notify via Apprise (https://github.com/caronc/apprise) on staleness,
# hypertensive-crisis-range readings, or an irregular heartbeat flag.
# Checked by etekcity-bp-alert-check, run periodically (see
# etekcity-bp-alert-check.timer) -- nothing here runs automatically on its
# own. Defaults to no.
enabled = no
# Comma-separated Apprise service URLs, e.g. tgram://bot_token/chat_id.
# Required if enabled = yes.
apprise_urls =
# Alert if a user slot hasn't reported in this many days. 0 disables this check.
stale_after_days = 0
# Alert if the latest reading's systolic/diastolic is at or above these
# thresholds (the AHA's hypertensive-crisis range starts above 180/120).
# 0 disables the respective check.
crisis_systolic_mmhg = 180
crisis_diastolic_mmhg = 120
# Alert when a reading's irregular-heartbeat flag is set. Defaults to no.
alert_on_irregular_heartbeat = no
# Where to persist per-user-slot alert state (throttling repeat alerts).
state_path = /var/lib/etekcity-bp-daemon/alert-state.json

[api]
# Lightweight local HTTP API (etekcity-bp-api): GET /health, /latest, and
# /report. Defaults to no. There's no TLS built in -- keep host bound to
# loopback (the default) unless it sits behind a reverse proxy.
enabled = no
# Bind address. Change to 0.0.0.0 (or a specific interface) only if you
# understand the exposure -- set token below if you do.
host = 127.0.0.1
port = 8080
# Optional bearer token: if set, all endpoints except /health require an
# "Authorization: Bearer <token>" header. Leave blank for no auth (fine
# for loopback-only use).
token =

[profiles]
# Ask "who was this?" for each reading, for a device shared by more than
# one person. The device's own user slot (0/1) can't be used for this --
# it only ever reports one of two values no matter how many people actually
# share the device, so it can't tell a third or fourth person apart from
# whoever normally uses that slot. Defaults to no. Two delivery paths,
# chosen automatically:
#   - If [api] is enabled: an ntfy notification (Android/iOS apps, or any
#     browser) with one HTTP action button per name below, each calling
#     back into this API's /assign-profile endpoint when tapped. Needs
#     ntfy_url set.
#   - If [api] is disabled: a local dunstify prompt instead, since ntfy's
#     action buttons would have nothing to call back to. Needs dunstify
#     (part of the dunst notification daemon) and a real desktop/D-Bus
#     session -- this won't reach anywhere from a headless system service
#     without one, so it's mainly useful running the daemon on your own
#     desktop/laptop rather than an unattended Pi.
enabled = no
# Comma-separated list of names to choose between. No limit -- unlike the
# device's own user slots, any number of people can share the tagging.
names =
# Required only when [api] is enabled: an ntfy topic URL, e.g.
# https://ntfy.sh/your-topic or a self-hosted https://ntfy.example.com/your-topic.
ntfy_url =
# Optional access token, if your ntfy server/topic requires auth.
ntfy_token =
# Where this API is reachable, for the ntfy action buttons to call back
# into. Only used when [api] is enabled.
api_base_url = http://127.0.0.1:8080
# Seconds to wait for a dunstify response before giving up. Only used
# when [api] is disabled.
dunstify_timeout_seconds = 30
# Reject /assign-profile requests tagging a reading older than this many
# seconds, unless &confirm=1 is also passed. Guards against a delayed
# ntfy notification -- tapped long after it was sent, once connectivity
# returns -- silently tagging a now-stale reading. 0 disables the check
# (the default). Only relevant when [api] is enabled.
assign_window_seconds = 0
